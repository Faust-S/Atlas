{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IWXA Atlas",
  "version": "0.7.0-dev.1",
  "identifier": "ru.iwxa.atlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IWXA Atlas",
        "width": 1320,
        "height": 850,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self' tauri:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
